#!/usr/bin/env bash
# Выбор обоев через fuzzel (Super+W). Выбор сохраняется и переживает перезагрузку.
# Повторный запуск закрывает меню.

ENVF="$HOME/.config/mango/settings.env"
PROMPT="Обои ❯ "
[ -f "$ENVF" ] && . "$ENVF"

if pgrep -f "fuzzel.*--dmenu.*--prompt ${PROMPT}" >/dev/null 2>&1; then
  pkill -f "fuzzel.*--dmenu.*--prompt ${PROMPT}" >/dev/null 2>&1 || true
  exit 0
fi

d="${WALLPAPER_DIR:-$HOME/Pictures/Wallpapers}"
[ -d "$d" ] || d="$HOME/Pictures"

list=$(find -L "$d" -maxdepth 3 -type f \
  \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.bmp' \) \
  -printf '%P\n' 2>/dev/null | sort)
if [ -z "$list" ]; then
  notify-send "Обои" "В $d нет картинок" 2>/dev/null
  exit 1
fi

choice=$( { echo "★ Случайные обои"; echo "$list"; } | fuzzel --dmenu --lines 12 --width 50 --prompt "$PROMPT")
[ -n "$choice" ] || exit 0
if [ "$choice" = "★ Случайные обои" ]; then
  exec "$HOME/.config/mango/scripts/wallpaper" random
fi
exec "$HOME/.config/mango/scripts/wallpaper" set "$d/$choice"
