#!/usr/bin/env bash
# Меню питания (повторный запуск закрывает меню)

PROMPT="Питание ❯ "
if pgrep -f "fuzzel.*--dmenu.*--prompt ${PROMPT}" >/dev/null 2>&1; then
  pkill -f "fuzzel.*--dmenu.*--prompt ${PROMPT}" >/dev/null 2>&1 || true
  exit 0
fi

choice=$(printf '%s\n' \
  "1  Блокировка" \
  "2  Выйти из сессии" \
  "3  Сон" \
  "4  Перезагрузка" \
  "5  Выключение" \
  | fuzzel --dmenu --lines 5 --width 26 --prompt "$PROMPT" 2>/dev/null)

case "$choice" in
  1*|Блокировка*)
    exec "$HOME/.config/mango/scripts/lock"
    ;;
  2*|Выйти*)
    # Штатный выход mango: вернёт в экран входа (если вход через DM) или в TTY-шелл (если запускали из TTY)
    mmsg dispatch quit 2>/dev/null || mmsg -d quit 2>/dev/null
    sleep 1
    pkill -TERM -x mango 2>/dev/null
    ;;
  3*|Сон*)
    systemctl suspend
    ;;
  4*|Перезагрузка*)
    systemctl reboot
    ;;
  5*|Выключение*)
    systemctl poweroff
    ;;
esac
