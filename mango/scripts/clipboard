#!/usr/bin/env bash
# История буфера обмена (Super+C). Нужны: cliphist, wl-clipboard, fuzzel.
# clipboard         — выбрать из истории и вставить в буфер
# clipboard clear   — очистить историю
if ! command -v cliphist >/dev/null 2>&1; then
  notify-send "Буфер обмена" "Поставь cliphist: sudo pacman -S cliphist" 2>/dev/null
  exit 1
fi
if [ "$1" = clear ]; then
  cliphist wipe && notify-send -t 1500 "Буфер обмена" "История очищена" 2>/dev/null
  exit 0
fi
choice=$(cliphist list | fuzzel --dmenu --lines 12 --width 60 --prompt "Буфер ❯ ")
[ -n "$choice" ] || exit 0
printf '%s' "$choice" | cliphist decode | wl-copy
