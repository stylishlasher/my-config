#!/usr/bin/env bash
# toggle-scroller — переключает раскладку scroller <-> tile (бинд Super+`)
# Совместимо с mmsg: "mmsg get ..." / "mmsg dispatch setlayout,<name>"
set -u

LOG="${XDG_CACHE_HOME:-$HOME/.cache}/mango-toggle-scroller.log"
STATE="${XDG_CACHE_HOME:-$HOME/.cache}/mango-layout-toggle"

have() { command -v "$1" >/dev/null 2>&1; }

log() {
  mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
  printf '%s %s\n' "$(date '+%F %T' 2>/dev/null || echo now)" "$*" >>"$LOG" 2>/dev/null || true
}

try_run() {
  log "try: $*"
  if "$@" >/dev/null 2>&1; then
    log "ok: $*"
    return 0
  fi
  return 1
}

# Попытаться распознать текущую раскладку по выводу mmsg
parse_layout_output() {
  local out="$1"
  [ -n "$out" ] || return 1

  # Явные имена раскладок (без слишком широкого совпадения "scroll" в заголовках окон)
  if printf '%s\n' "$out" | grep -Eqi '(^|[[:space:]",:{])scroller([[:space:]",}:]|$)'; then
    echo "scroller"; return 0
  fi
  if printf '%s\n' "$out" | grep -Eqi '(^|[[:space:]",:{])(tile|tiling)([[:space:]",}]|$)'; then
    echo "tile"; return 0
  fi

  # Символы/поля layout/layout_symbol
  if printf '%s\n' "$out" | grep -Eq '"layout"[[:space:]]*:[[:space:]]*"(S|scroller)"|layout_symbol[[:space:]:=]+S([[:space:]]|$)|(^|[[:space:]])layout[[:space:]:=]+S([[:space:]]|$)'; then
    echo "scroller"; return 0
  fi
  if printf '%s\n' "$out" | grep -Eq '"layout"[[:space:]]*:[[:space:]]*"(T|tile|tiling)"|layout_symbol[[:space:]:=]+T([[:space:]]|$)|(^|[[:space:]])layout[[:space:]:=]+(T|tile|tiling)([[:space:]]|$)'; then
    echo "tile"; return 0
  fi

  # Последнее слово/значение layout как fallback
  local name
  name=$(printf '%s\n' "$out" | awk '
    {
      for (i=1; i<=NF; i++) {
        k=$i; gsub(/[",:]/, "", k)
        if ((k=="layout" || k=="lt" || k=="layout_name" || k=="layout_symbol") && i<NF) {
          v=$(i+1); gsub(/[",:]/, "", v); print v; found=1; exit
        }
      }
    }
    END { if (!found && NF>0) { v=$NF; gsub(/[",:]/, "", v); print v } }
  ' | head -n1 | tr -d '\r')
  case "$name" in
    scroller|S|Scroller) echo "scroller"; return 0 ;;
    tile|tiling|T|Tile|tiled) echo "tile"; return 0 ;;
  esac
  return 1
}

get_layout() {
  local out mon parsed

  # 1) Попробовать определить текущий монитор
  mon=""
  for q in "mmsg get cursorpos" "mmsg get focusing-client"; do
    out=$($q 2>/dev/null || true)
    [ -n "$out" ] || continue
    log "query '$q' => $(printf '%s' "$out" | tr '\n' ' ' | head -c 240)"
    if [ -z "$mon" ]; then
      mon=$(printf '%s\n' "$out" | sed -n 's/.*"monitor"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)
      [ -z "$mon" ] && mon=$(printf '%s\n' "$out" | sed -n 's/.*monitor[[:space:]:=]\+\([^[:space:],}"]\+\).*/\1/p' | head -n1)
    fi
  done

  # 2) Сначала монитор-специфичные запросы (наиболее надёжно)
  if [ -n "$mon" ]; then
    for q in "mmsg get monitor $mon" "mmsg get tags $mon"; do
      out=$($q 2>/dev/null || true)
      [ -n "$out" ] || continue
      log "query '$q' => $(printf '%s' "$out" | tr '\n' ' ' | head -c 240)"
      parsed="$(parse_layout_output "$out" || true)"
      if [ -n "$parsed" ]; then echo "$parsed"; return 0; fi
    done
  fi

  # 3) Общие запросы
  for q in "mmsg get all-monitors" "mmsg get all-tags" "mmsg get focusing-client"; do
    out=$($q 2>/dev/null || true)
    [ -n "$out" ] || continue
    case "$q" in "mmsg get focusing-client") ;; *) log "query '$q' => $(printf '%s' "$out" | tr '\n' ' ' | head -c 240)";; esac
    parsed="$(parse_layout_output "$out" || true)"
    if [ -n "$parsed" ]; then echo "$parsed"; return 0; fi
  done

  return 1
}

dispatch_setlayout() {
  local target="$1"
  local alias=""
  case "$target" in
    scroller) alias="S" ;;
    tile) alias="T" ;;
  esac

  local -a names=("$target")
  [ -n "$alias" ] && names+=("$alias")
  [ "$target" = "tile" ] && names+=("tiling")

  local name
  for name in "${names[@]}"; do
    try_run mmsg dispatch "setlayout,$name" && return 0
    try_run mmsg dispatch setlayout "$name" && return 0
    try_run mmsg dispatch "setlayout,$name,0" && return 0
    try_run mmsg -d "setlayout,$name" && return 0
    try_run mmsg -s -d "setlayout,$name" && return 0
  done

  log "dispatch failed for target=$target"
  return 1
}

if ! have mmsg; then
  log "mmsg not found in PATH=${PATH:-}"
  exit 0
fi

log "---- toggle-scroller start (pid=$$) ----"
log "mmsg=$(command -v mmsg 2>/dev/null || echo '?')"

cur="$(get_layout || true)"
if [ -z "$cur" ]; then
  prev="$(cat "$STATE" 2>/dev/null || echo tile)"
  case "$prev" in
    scroller|scroll*|S|Scroller) cur="scroller" ;;
    *) cur="tile" ;;
  esac
  log "layout unknown, fallback state='$prev' -> assume cur='$cur'"
else
  log "detected layout='$cur'"
fi

case "$cur" in
  scroller|scroll*|S|Scroller) target="tile" ;;
  *) target="scroller" ;;
esac

if dispatch_setlayout "$target"; then
  mkdir -p "$(dirname "$STATE")" 2>/dev/null || true
  printf '%s\n' "$target" >"$STATE" 2>/dev/null || true
  log "result: cur='$cur' target='$target'"
else
  # Не обновляем state при неуспехе, чтобы следующий toggle не «залипал» неверно
  log "result: failed to switch from cur='$cur' to '$target'"
fi

exit 0
