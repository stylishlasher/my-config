#!/usr/bin/env bash
# screenshot        — область → файл + буфер обмена
# screenshot full   — весь экран
# screenshot edit   — область → открыть в satty для редактирования
# (блюр/анимацию слоя выделения гасит layer_rule в config.conf)
set -euo pipefail

dir="$HOME/Pictures/Screenshots"
mkdir -p "$dir"
f="$dir/$(date +%F_%H-%M-%S).png"

notify() { command -v notify-send >/dev/null 2>&1 && notify-send -t 2200 "Скриншот" "$1" 2>/dev/null || true; }

case "${1:-}" in
  full)
    command -v grim >/dev/null 2>&1 || { echo "grim не найден" >&2; exit 1; }
    grim "$f" || exit 1
    wl-copy < "$f" 2>/dev/null || true
    notify "Сохранён: $(basename "$f")"
    ;;
  edit|satty)
    command -v grim >/dev/null 2>&1 || { echo "grim не найден" >&2; exit 1; }
    command -v slurp >/dev/null 2>&1 || { echo "slurp не найден" >&2; exit 1; }
    area=$(slurp -b '#00000000' -c '#cba6f7ff' -s '#cba6f750' -w 2) || exit 0
    sleep 0.15
    grim -g "$area" "$f" || exit 1
    if command -v satty >/dev/null 2>&1; then
      # Открыть в редакторе satty (аннотации/обрезка/стрелки и т.д.)
      satty --filename "$f" --output-filename "$f" --copy-command 'wl-copy' --early-exit >/dev/null 2>&1 \
        || satty --filename "$f" --output-filename "$f" >/dev/null 2>&1 \
        || satty --filename "$f" >/dev/null 2>&1 \
        || true
      wl-copy < "$f" 2>/dev/null || true
      notify "Открыто в satty: $(basename "$f")"
    else
      wl-copy < "$f" 2>/dev/null || true
      notify "satty не установлен, сохранено: $(basename "$f")"
    fi
    ;;
  *)
    command -v grim >/dev/null 2>&1 || { echo "grim не найден" >&2; exit 1; }
    command -v slurp >/dev/null 2>&1 || { echo "slurp не найден" >&2; exit 1; }
    area=$(slurp -b '#00000000' -c '#cba6f7ff' -s '#cba6f750' -w 2) || exit 0
    sleep 0.15
    grim -g "$area" "$f" || exit 1
    wl-copy < "$f" 2>/dev/null || true
    notify "Сохранён: $(basename "$f")"
    ;;
esac

exit 0
