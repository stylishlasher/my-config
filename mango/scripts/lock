#!/usr/bin/env bash
# Красивая блокировка экрана (Catppuccin Mocha + blur если есть swaylock-effects)

# Цвета Catppuccin Mocha
RING="313244"
RING_CLEAR="f5e0dc"
RING_CAPS="fab387"
RING_VER="89b4fa"
RING_WRONG="eba0ac"
INSIDE="1e1e2eee"
KEY_HL="a6e3a1"
TEXT="cdd6f4"
BS_HL="f5e0dc"
ACCENT="cba6f7"

# Пробуем swaylock-effects (скриншот + блюр + часы) — самый красивый вариант
if command -v swaylock-effects >/dev/null 2>&1 || swaylock --help 2>&1 | grep -q "effect-blur\|screenshots"; then
  exec swaylock \
    --screenshots \
    --clock \
    --timestr "%H:%M" \
    --datestr "%a, %d %b" \
    --indicator \
    --indicator-radius 110 \
    --indicator-thickness 8 \
    --effect-blur 8x4 \
    --effect-vignette 0.3:0.3 \
    --fade-in 0.25 \
    --grace 1 \
    --font "JetBrainsMono Nerd Font" \
    --font-size 22 \
    --ring-color "$RING" \
    --ring-clear-color "$RING_CLEAR" \
    --ring-caps-lock-color "$RING_CAPS" \
    --ring-ver-color "$RING_VER" \
    --ring-wrong-color "$RING_WRONG" \
    --inside-color "$INSIDE" \
    --inside-clear-color "$INSIDE" \
    --inside-caps-lock-color "$INSIDE" \
    --inside-ver-color "$INSIDE" \
    --inside-wrong-color "$INSIDE" \
    --key-hl-color "$KEY_HL" \
    --bs-hl-color "$BS_HL" \
    --text-color "$TEXT" \
    --text-clear-color "$RING_CLEAR" \
    --text-caps-lock-color "$RING_CAPS" \
    --text-ver-color "$RING_VER" \
    --text-wrong-color "$RING_WRONG" \
    --line-color 00000000 \
    --separator-color 00000000 \
    --layout-bg-color 00000000 \
    --layout-border-color 00000000 \
    --layout-text-color "$TEXT"
fi

# Обычный swaylock — красивые цвета + картинка если есть
IMG=""
if [ -f "$HOME/.config/mango/settings.env" ]; then
  . "$HOME/.config/mango/settings.env"
  [ -n "$WALLPAPER" ] && [ -f "$WALLPAPER" ] && IMG="$WALLPAPER"
fi

ARGS=(
  -f
  --indicator-radius 110
  --indicator-thickness 8
  --ring-color "$RING"
  --ring-clear-color "$RING_CLEAR"
  --ring-caps-lock-color "$RING_CAPS"
  --ring-ver-color "$RING_VER"
  --ring-wrong-color "$RING_WRONG"
  --inside-color "$INSIDE"
  --inside-clear-color "$INSIDE"
  --inside-caps-lock-color "$INSIDE"
  --inside-ver-color "$INSIDE"
  --inside-wrong-color "$INSIDE"
  --key-hl-color "$KEY_HL"
  --bs-hl-color "$BS_HL"
  --text-color "$TEXT"
  --text-clear-color "$RING_CLEAR"
  --text-caps-lock-color "$RING_CAPS"
  --text-ver-color "$RING_VER"
  --text-wrong-color "$RING_WRONG"
  --line-color 00000000
  --separator-color 00000000
  --font "JetBrainsMono Nerd Font"
)

if [ -n "$IMG" ]; then
  exec swaylock "${ARGS[@]}" -i "$IMG" -s fill
else
  exec swaylock "${ARGS[@]}" -c 1e1e2e
fi
