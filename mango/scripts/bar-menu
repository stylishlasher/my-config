#!/usr/bin/env bash
# Кастомные меню для модулей Waybar (минималистичные, fzf/terminal UI)
# Использование: bar-menu {clock|audio|network|battery}
# Повторный запуск того же меню — закрывает его (toggle)
set -u

ENVF="$HOME/.config/mango/settings.env"
SCR="$HOME/.config/mango/scripts"

have() { command -v "$1" >/dev/null 2>&1; }

load_env() {
  ACCENT=cba6f7
  WEATHER_LOCATION=""
  [ -f "$ENVF" ] && . "$ENVF" 2>/dev/null || true
  # нормализовать (убрать кавычки/пробелы по краям)
  WEATHER_LOCATION="${WEATHER_LOCATION#\"}"; WEATHER_LOCATION="${WEATHER_LOCATION%\"}"
  WEATHER_LOCATION="${WEATHER_LOCATION#\'}"; WEATHER_LOCATION="${WEATHER_LOCATION%\'}"
  WEATHER_LOCATION="${WEATHER_LOCATION#${WEATHER_LOCATION%%[![:space:]]*}}"
  WEATHER_LOCATION="${WEATHER_LOCATION%${WEATHER_LOCATION##*[![:space:]]}}"
}

# Атомарно записать/обновить ключ в settings.env
set_env() {
  local key="$1" val="$2" tmp found=0
  mkdir -p "$(dirname "$ENVF")"
  touch "$ENVF"
  if have flock; then
    exec 9>"$ENVF.lock"
    flock 9
  fi
  tmp="$(mktemp "$(dirname "$ENVF")/.settings.env.XXXXXX")" || {
    if have flock; then flock -u 9 2>/dev/null || true; exec 9>&- 2>/dev/null || true; fi
    return 1
  }
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "${key}="*) printf '%s=%q\n' "$key" "$val" >> "$tmp"; found=1 ;;
      *)          printf '%s\n' "$line" >> "$tmp" ;;
    esac
  done < "$ENVF"
  [ "$found" = 1 ] || printf '%s=%q\n' "$key" "$val" >> "$tmp"
  mv "$tmp" "$ENVF"
  if have flock; then
    flock -u 9 2>/dev/null || true
    exec 9>&- 2>/dev/null || true
  fi
}

notify() {
  have notify-send && notify-send -t "${2:-2000}" "$1" "${3:-}" 2>/dev/null || true
}

# ── Toggle / запуск в foot ───────────────────────────────────────────────
toggle_menu() {
  local id="$1"; shift
  if pgrep -f -- "--app-id ${id}" >/dev/null 2>&1; then
    pkill -f -- "--app-id ${id}" >/dev/null 2>&1 || true
    exit 0
  fi
  exec foot --app-id "$id" -W 92x34 -e "$0" --internal "$@"
}

# ── UI helpers (fzf + ANSI) ──────────────────────────────────────────────
clr() { printf '\033[%sm%s\033[0m' "$1" "$2"; }
bold() { clr "1" "$1"; }
fg() { clr "$1" "$2"; } # e.g. 31 red, 32 green, 33 yellow, 36 cyan, 90 gray

ui_line() { printf '  %s\n' "$*"; }
ui_dim()  { ui_line "$(fg '90' "$*")"; }
ui_accent(){ ui_line "$(bold "$(fg '35' "$*")")"; }
ui_warn() { ui_line "$(fg '33' "$*")"; }
ui_err()  { ui_line "$(fg '31' "$*")"; }

require_ui() {
  have fzf && return 0
  echo "Нужен fzf: sudo pacman -S fzf"
  echo; read -r -p "Нажмите Enter для выхода..." _ || true
  exit 1
}

header() {
  clear
  local title="$1"
  echo
  ui_line "$(bold "$(fg '35' "━━━ $title ━━━")")"
  echo
}

ui_choose() {
  # ui_choose "header" "opt1" "opt2" ...
  local hdr="$1"; shift
  [ $# -eq 0 ] && return 1
  printf '%s\n' "$@" | fzf --height=~40% --min-height=8 --layout=reverse --border=rounded \
    --prompt="› " --header="$hdr" --no-multi --ansi --cycle \
    --bind 'esc:abort' 2>/dev/null
}

ui_input() {
  # ui_input "prompt" "default" -> prints value, returns 1 if empty/cancelled
  local prompt="$1" def="${2:-}" val
  if [ -n "$def" ]; then
    read -r -e -p "  $prompt " -i "$def" val || return 1
  else
    read -r -e -p "  $prompt " val || return 1
  fi
  val="${val#${val%%[![:space:]]*}}"; val="${val%${val##*[![:space:]]}}"
  [ -n "$val" ] || return 1
  printf '%s' "$val"
}

# ── CLOCK: календарь + погода + прогноз (город задаётся вручную) ─────────
weather_fetch() {
  local loc="$1" q
  [ -n "$loc" ] || return 0
  q="${loc// /+}"
  q="${q#/}"
  curl -fsS --max-time 8 "https://wttr.in/${q}?lang=ru&M&format=j1" 2>/dev/null
}

weather_render() {
  local json="$1" req_loc="$2"
  if [ -z "$json" ]; then
    ui_err "Не удалось получить погоду."
    ui_dim "Проверьте сеть и название города, затем нажмите «Обновить»."
    return 0
  fi

  local current
  current="$(python3 - "$req_loc" <<'PY' "$json" 2>/dev/null
import json, sys

req_loc = sys.argv[1] if len(sys.argv) > 1 else ""
try:
    data = json.loads(sys.argv[2])
except Exception:
    sys.exit(1)

def pick_desc(arr):
    if not arr:
        return ""
    v = arr[0].get('lang_ru') or arr[0].get('value') or ""
    if isinstance(v, list) and v:
        v = v[0].get('value', '')
    return str(v).strip()

cur = (data.get('current_condition') or [{}])[0]
area = (data.get('nearest_area') or [{}])[0]
place = req_loc
try:
    an = (area.get('areaName') or [{}])[0].get('value', '').strip()
    cn = (area.get('country') or [{}])[0].get('value', '').strip()
    if an or cn:
        place = ", ".join([x for x in [an, cn] if x])
except Exception:
    pass

desc = pick_desc(cur.get('lang_ru') or cur.get('weatherDesc') or [])
temp = cur.get('temp_C', '?')
feels = cur.get('FeelsLikeC', '?')
hum = cur.get('humidity', '?')
wind = cur.get('windspeedKmph', '?')

icon = "🌡"
d = desc.lower()
if any(k in d for k in ["гроза", "thunder"]): icon = "⛈"
elif any(k in d for k in ["снег", "snow", "метель", "поземок"]): icon = "❄"
elif any(k in d for k in ["дожд", "rain", "лив", "морос"]): icon = "🌧"
elif any(k in d for k in ["туман", "fog", "mist", "дымк"]): icon = "🌫"
elif any(k in d for k in ["пасмур", "overcast", "облач"]): icon = "☁"
elif any(k in d for k in ["ясн", "sun", "clear"]): icon = "☀"
elif any(k in d for k in ["перемен", "partly", "облачно с прояснениями"]): icon = "⛅"

print(f"PLACE::{place}")
print(f"HEAD::{icon}  {temp}°C  ·  {desc or '—'}")
print(f"META::Ощущается {feels}°C   •   Влажность {hum}%   •   Ветер {wind} км/ч")
PY
)"
  if [ -z "$current" ]; then
    ui_err "Ошибка разбора данных погоды."
    return 0
  fi

  local place head meta
  place="$(printf '%s\n' "$current" | sed -n 's/^PLACE:://p' | head -n1)"
  head="$(printf '%s\n' "$current"  | sed -n 's/^HEAD:://p'  | head -n1)"
  meta="$(printf '%s\n' "$current"  | sed -n 's/^META:://p'  | head -n1)"

  ui_line "$(bold "󰖐  ${place:-$req_loc}")"
  ui_line "$(fg '36' "$head")"
  ui_dim "$meta"
  echo

  local forecast
  forecast="$(python3 - <<'PY' "$json" 2>/dev/null
import json, sys, datetime

try:
    data = json.loads(sys.argv[1])
except Exception:
    sys.exit(0)

def pick_desc(arr):
    if not arr:
        return ""
    v = arr[0].get('lang_ru') or arr[0].get('value') or ""
    if isinstance(v, list) and v:
        v = v[0].get('value', '')
    return str(v).strip()

def icon_for(desc):
    d = (desc or "").lower()
    if any(k in d for k in ["гроза", "thunder"]): return "⛈"
    if any(k in d for k in ["снег", "snow", "метель", "поземок"]): return "❄"
    if any(k in d for k in ["дожд", "rain", "лив", "морос"]): return "🌧"
    if any(k in d for k in ["туман", "fog", "mist", "дымк"]): return "🌫"
    if any(k in d for k in ["пасмур", "overcast"]): return "☁"
    if any(k in d for k in ["облач", "перемен", "partly"]): return "⛅"
    if any(k in d for k in ["ясн", "sun", "clear"]): return "☀"
    return "•"

ru_days = ['Пн','Вт','Ср','Чт','Пт','Сб','Вс']
labels = {0: "Сегодня", 1: "Завтра"}

days = data.get('weather') or []
for i, d in enumerate(days[:3]):
    date_s = d.get('date','')
    try:
        dt = datetime.datetime.strptime(date_s, '%Y-%m-%d').date()
        label = labels.get(i, ru_days[dt.weekday()] + dt.strftime(' %d.%m'))
    except Exception:
        label = labels.get(i, date_s or f'День {i+1}')
    maxt = d.get('maxtempC','?')
    mint = d.get('mintempC','?')
    hourly = d.get('hourly') or []
    mid = hourly[len(hourly)//2] if hourly else {}
    desc = pick_desc(mid.get('lang_ru') or mid.get('weatherDesc') or [])
    ic = icon_for(desc)
    print(f"{label:<10}  {ic}  {mint:>3}..{maxt:<3}°C   {desc}")
PY
)"
  if [ -n "$forecast" ]; then
    ui_line "$(bold "Прогноз")"
    while IFS= read -r line; do
      [ -n "$line" ] && ui_line "  $line"
    done <<< "$forecast"
  fi
}

prompt_city() {
  local current="${WEATHER_LOCATION:-}" nl
  echo
  nl=$(ui_input "Город (напр. Moscow, Berlin):" "$current") || return 1
  if [ -z "$nl" ]; then
    ui_warn "Город не указан."
    sleep 0.8
    return 1
  fi
  set_env WEATHER_LOCATION "$nl"
  load_env
  return 0
}

menu_clock() {
  require_ui
  load_env
  while true; do
    header "Календарь и погода"

    ui_line "$(bold "$(date '+%H:%M:%S')")"
    ui_dim "$(date '+%A, %d %B %Y')"
    echo

    if have cal; then
      cal -m 2>/dev/null | sed 's/^/  /' || cal 2>/dev/null | sed 's/^/  /' || true
      echo
    fi

    if [ -z "${WEATHER_LOCATION:-}" ]; then
      ui_line "$(bold "󰖐  Погода")"
      ui_dim "Город не указан."
      ui_dim "Укажите название вашего города, чтобы видеть погоду и прогноз."
      echo
      local c0
      c0=$(ui_choose "Действие" "Указать город" "Закрыть") || exit 0
      case "$c0" in
        "Указать город") prompt_city || true ;;
        *) exit 0 ;;
      esac
      continue
    fi

    ui_line "$(bold "󰖐  Погода")"
    local wjson
    wjson="$(weather_fetch "$WEATHER_LOCATION")"
    weather_render "$wjson" "$WEATHER_LOCATION"
    echo

    local c
    c=$(ui_choose "Действие" "Обновить" "Сменить город" "Закрыть") || exit 0
    case "$c" in
      "Обновить") continue ;;
      "Сменить город") prompt_city || true ;;
      "Закрыть"|*) exit 0 ;;
    esac
  done
}

# ── AUDIO ────────────────────────────────────────────────────────────────
audio_info() {
  local vol="?" mute="no"
  if have wpctl; then
    local out
    out=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || true)
    vol=$(awk '{v=$2*100; printf "%d", (v>=0)?v:0}' <<<"$out")
    grep -q MUTED <<<"$out" && mute="yes" || mute="no"
  elif have pactl; then
    vol=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | grep -oP '\d+%' | head -1 | tr -d '%')
    [ -z "$vol" ] && vol="?"
    local m; m=$(pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null || true)
    grep -qi yes <<<"$m" && mute="yes" || mute="no"
  fi
  printf '%s|%s' "$vol" "$mute"
}

audio_set() {
  local v="$1"
  if have wpctl; then wpctl set-volume @DEFAULT_AUDIO_SINK@ "${v}%"
  elif have pactl; then pactl set-sink-volume @DEFAULT_SINK@ "${v}%"; fi
}

audio_mute_toggle() {
  if have wpctl; then wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
  elif have pactl; then pactl set-sink-mute @DEFAULT_SINK@ toggle; fi
}

menu_audio() {
  require_ui
  load_env
  while true; do
    header "Звук"
    local info vol mute mlabel
    info=$(audio_info); vol="${info%%|*}"; mute="${info##*|}"
    [ "$mute" = "yes" ] && mlabel="выкл (muted)" || mlabel="вкл"
    ui_line "Громкость: $(bold "${vol}%")   ·   Звук: $mlabel"
    echo
    local c
    c=$(ui_choose "Действие" \
      "Громкость 100%" "Громкость 75%" "Громкость 50%" "Громкость 25%" "Громкость 10%" \
      "Вкл/выкл звук (mute)" \
      "Открыть микшер (pavucontrol)" \
      "Закрыть") || exit 0
    case "$c" in
      "Громкость 100%") audio_set 100 ;;
      "Громкость 75%")  audio_set 75 ;;
      "Громкость 50%")  audio_set 50 ;;
      "Громкость 25%")  audio_set 25 ;;
      "Громкость 10%")  audio_set 10 ;;
      "Вкл/выкл звук (mute)") audio_mute_toggle ;;
      "Открыть микшер (pavucontrol)")
        have pavucontrol && (pavucontrol >/dev/null 2>&1 &)
        ;;
      "Закрыть"|*) exit 0 ;;
    esac
  done
}

# ── NETWORK ──────────────────────────────────────────────────────────────
menu_network() {
  require_ui
  load_env
  while true; do
    header "Сеть"
    if have nmcli; then
      ui_line "$(bold "Состояние:")"
      nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device status 2>/dev/null | \
        awk -F: '{printf "   • %s (%s): %s %s\n",$1,$2,$3,($4!=""&&$4!="--"?"— "$4:"")}' || echo "   (недоступно)"
      echo
      local wifi
      wifi=$(nmcli -t -f WIFI g 2>/dev/null | head -1)
      ui_dim "Wi‑Fi: ${wifi:-?}"
    else
      ui_dim "nmcli (NetworkManager) не найден."
    fi
    echo
    local c
    c=$(ui_choose "Действие" \
      "Открыть nmtui (подключение/пароли)" \
      "Включить Wi‑Fi" "Выключить Wi‑Fi" \
      "Обновить" "Закрыть") || exit 0
    case "$c" in
      "Открыть nmtui (подключение/пароли)")
        if [ -x "$SCR/launch" ]; then "$SCR/launch" nmtui >/dev/null 2>&1 & else have nmtui && (foot -e nmtui >/dev/null 2>&1 &); fi
        ;;
      "Включить Wi‑Fi")  nmcli radio wifi on 2>/dev/null || true ;;
      "Выключить Wi‑Fi") nmcli radio wifi off 2>/dev/null || true ;;
      "Обновить") continue ;;
      "Закрыть"|*) exit 0 ;;
    esac
  done
}

# ── BATTERY / POWER ──────────────────────────────────────────────────────
menu_battery() {
  require_ui
  load_env
  while true; do
    header "Питание и батарея"
    local shown=0
    for bat in /sys/class/power_supply/BAT*; do
      [ -d "$bat" ] || continue
      shown=1
      local cap status
      cap=$(cat "$bat/capacity" 2>/dev/null || echo "?")
      status=$(cat "$bat/status" 2>/dev/null || echo "?")
      ui_line "Батарея: $(bold "${cap}%")  ·  ${status}"
      [ -f "$bat/power_now" ] && [ -f "$bat/energy_now" ] && {
        python3 - "$bat" <<'PY' 2>/dev/null || true
import sys, os
b=sys.argv[1]
try:
    p=float(open(os.path.join(b,'power_now')).read())
    e=float(open(os.path.join(b,'energy_now')).read())
    if p>0:
        h=e/p
        print(f"  Осталось примерно: {int(h)}ч {int((h%1)*60)}м")
except Exception:
    pass
PY
      }
      echo
    done
    if [ "$shown" -eq 0 ]; then
      ui_dim "Батарея не обнаружена (настольный ПК?)."
      echo
    fi

    if have powerprofilesctl; then
      local prof
      prof=$(powerprofilesctl get 2>/dev/null || echo "недоступно")
      ui_dim "Профиль питания: ${prof}"
      echo
    fi

    local -a opts=("Обновить")
    if have powerprofilesctl; then
      opts+=("Профиль: power-saver" "Профиль: balanced" "Профиль: performance")
    fi
    opts+=("Открыть меню питания" "Закрыть")

    local c
    c=$(ui_choose "Действие" "${opts[@]}") || exit 0
    case "$c" in
      "Обновить") continue ;;
      "Профиль: power-saver")   powerprofilesctl set power-saver 2>/dev/null || true ;;
      "Профиль: balanced")      powerprofilesctl set balanced 2>/dev/null || true ;;
      "Профиль: performance")   powerprofilesctl set performance 2>/dev/null || true ;;
      "Открыть меню питания")   [ -x "$SCR/power-menu" ] && "$SCR/power-menu" >/dev/null 2>&1 & ;;
      "Закрыть"|*) exit 0 ;;
    esac
  done
}

# ── entrypoint ───────────────────────────────────────────────────────────
main() {
  local arg="${1:-}"
  if [ "$arg" = "--internal" ]; then
    shift
    load_env
    case "${1:-}" in
      clock)   menu_clock ;;
      audio)   menu_audio ;;
      network) menu_network ;;
      battery) menu_battery ;;
      *) exit 1 ;;
    esac
    exit 0
  fi

  load_env
  case "$arg" in
    clock)   toggle_menu "mango-menu-clock" clock ;;
    audio)   toggle_menu "mango-menu-audio" audio ;;
    network) toggle_menu "mango-menu-network" network ;;
    battery) toggle_menu "mango-menu-battery" battery ;;
    *)
      echo "Usage: $0 {clock|audio|network|battery}" >&2
      exit 1
      ;;
  esac
}

main "$@"
