#!/usr/bin/env bash
# wallpaper               — применить сохранённые обои (автозапуск)
# wallpaper set ФАЙЛ      — поставить и запомнить
# wallpaper random        — случайные из WALLPAPER_DIR
# wallpaper color HEX     — однотонный фон
# wallpaper mode РЕЖИМ    — fill | fit | stretch | center | tile
# wallpaper matugen       — сгенерировать цвета из текущих обоев
ENVF="$HOME/.config/mango/settings.env"
[ -f "$ENVF" ] && . "$ENVF"

set_env() {  # КЛЮЧ ЗНАЧЕНИЕ — переписать одну строку в settings.env
  touch "$ENVF"
  grep -v "^$1=" "$ENVF" > "$ENVF.tmp"
  printf '%s=%q\n' "$1" "$2" >> "$ENVF.tmp"
  mv "$ENVF.tmp" "$ENVF"
}

find_images() {
  local d="${WALLPAPER_DIR:-$HOME/Pictures/Wallpapers}"
  [ -d "$d" ] || d="$HOME/Pictures"
  find -L "$d" -maxdepth 3 -type f \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.bmp' \) 2>/dev/null
}

notify() { command -v notify-send >/dev/null && notify-send -t 1800 "Обои" "$1" 2>/dev/null; }

run_matugen() {
  # Режим цвета: matugen|manual (COLOR_MODE имеет приоритет, MATUGEN — для совместимости)
  local mode="${COLOR_MODE:-}"
  if [ -z "$mode" ]; then
    [ "${MATUGEN:-1}" = "1" ] && mode="matugen" || mode="manual"
  fi
  [ "$mode" = "matugen" ] || return 0
  command -v matugen >/dev/null 2>&1 || return 0
  local img="$1"
  [ -n "$img" ] && [ -f "$img" ] || return 0
  # Конфиг matugen лежит в ~/.config/matugen/config.toml
  matugen image "$img" -m "${MATUGEN_MODE:-dark}" \
    ${MATUGEN_TYPE:+-t "$MATUGEN_TYPE"} \
    --contrast "${MATUGEN_CONTRAST:-0}" \
    >/dev/null 2>&1 && notify "Matugen: цвета обновлены из обоев" || true
}

case "$1" in
  set)
    [ -f "$2" ] || { echo "нет файла: $2" >&2; exit 1; }
    set_env WALLPAPER "$(realpath "$2")"; notify "$(basename "$2")"
    run_matugen "$(realpath "$2")";;
  random)
    f=$(find_images | shuf -n1)
    [ -n "$f" ] || { notify "Картинки не найдены"; exit 1; }
    set_env WALLPAPER "$f"; notify "$(basename "$f")"
    run_matugen "$f";;
  color)
    hex="${2#\#}"
    [[ "$hex" =~ ^[0-9a-fA-F]{6}$ ]] || { echo "нужен HEX из 6 символов" >&2; exit 1; }
    set_env WALLPAPER ""; set_env WALLPAPER_COLOR "$hex";;
  mode)
    set_env WALLPAPER_MODE "$2";;
  clear)
    set_env WALLPAPER "";;
  matugen)
    [ -f "$ENVF" ] && . "$ENVF"
    if [ -n "$WALLPAPER" ] && [ -f "$WALLPAPER" ]; then
      run_matugen "$WALLPAPER"
    else
      notify "Нет текущих обоев для matugen"
      exit 1
    fi
    exit 0;;
esac

[ -f "$ENVF" ] && . "$ENVF"
old=$(pgrep -x swaybg)
if [ -n "$WALLPAPER" ] && [ -f "$WALLPAPER" ]; then
  setsid swaybg -i "$WALLPAPER" -m "${WALLPAPER_MODE:-fill}" -c "${WALLPAPER_COLOR:-1e1e2e}" >/dev/null 2>&1 &
else
  setsid swaybg -c "${WALLPAPER_COLOR:-1e1e2e}" >/dev/null 2>&1 &
fi
# старый swaybg убираем после запуска нового — без мигания
sleep 0.4
[ -n "$old" ] && kill $old 2>/dev/null
exit 0
