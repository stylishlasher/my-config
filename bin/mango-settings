}

menu_apps() {
  local c v; c=$(pick "Приложения по умолчанию" \
    "Браузер (Super+F): $BROWSER_CMD" "Терминал (Super+Enter): $TERMINAL_CMD" "Файлы (Super+E): $FILES_CMD") || return
  case "$c" in
    Браузер*)  v=$(ask "команда браузера" "$BROWSER_CMD") && set_env BROWSER_CMD "$v";;
    Терминал*) v=$(ask "команда терминала" "$TERMINAL_CMD") && set_env TERMINAL_CMD "$v";;
    Файлы*)    v=$(ask "команда файлового менеджера" "$FILES_CMD") && set_env FILES_CMD "$v";;
  esac
  msg "Сохранено"
}

dock_apply() {
  # перегенерировать и применить, если док запущен или включён автозапуском в этой сессии
  if [ -x "$SCR/dock" ]; then
    "$SCR/dock" generate >/dev/null 2>&1 || true
    if pgrep -f "waybar.*dock.jsonc" >/dev/null 2>&1; then
      "$SCR/dock" restart >/dev/null 2>&1 || true
    fi
  fi
}

dock_toggle_runtime() {
  if [ -x "$SCR/dock" ]; then
    "$SCR/dock" toggle >/dev/null 2>&1 || true
  else
    err "Скрипт дока не найден: $SCR/dock"
  fi
}

dock_is_running() { pgrep -f "waybar.*dock.jsonc" >/dev/null 2>&1; }

dock_default_apps() {
  mkdir -p "$(dirname "$DOCK_APPS")"
  cat > "$DOCK_APPS" <<'EOF'
~/.config/mango/scripts/launch terminal||Терминал
~/.config/mango/scripts/launch files||Файлы
~/.config/mango/scripts/launch browser|󰈹|Браузер
~/.config/mango/scripts/launch settings|󰒓|Настройки
EOF
}

menu_dock_apps() {
  while true; do
    mkdir -p "$(dirname "$DOCK_APPS")"; [ -f "$DOCK_APPS" ] || dock_default_apps
    local -a labels=() cmds=() icons=() names=()
    while IFS= read -r line || [ -n "$line" ]; do
      [[ -z "${line//[[:space:]]/}" || "$line" =~ ^[[:space:]]*# ]] && continue
      IFS='|' read -r cmd icon name <<< "$line"
      cmds+=("${cmd:-}")
      icons+=("${icon:-}")
      names+=("${name:-$cmd}")
      labels+=("${icon:-}  ${name:-$cmd}  →  ${cmd:-}")
    done < "$DOCK_APPS"

    local c
    if [ ${#labels[@]} -eq 0 ]; then
      c=$(pick "Закреплённые приложения дока (пусто)" "Добавить приложение" "Восстановить по умолчанию" "Редактировать файл вручную" "Назад") || return
    else
      c=$(pick "Закреплённые приложения дока" "${labels[@]}" "Добавить приложение" "Удалить приложение" "Восстановить по умолчанию" "Редактировать файл вручную" "Назад") || return
    fi

    case "$c" in
      "Назад") return;;
      "Восстановить по умолчанию")
        dock_default_apps; dock_apply; msg "Список приложений сброшен";;
      "Редактировать файл вручную")
        ${EDITOR:-nano} "$DOCK_APPS"; dock_apply; msg "Сохранено";;
      "Добавить приложение")
        local cmd icon name
        cmd=$(ask "Команда запуска (напр. firefox или ~/.config/mango/scripts/launch terminal)") || continue
        [ -z "${cmd// }" ] && continue
        icon=$(ask "Иконка Nerd Font (напр.  или 󰈹)" "") || continue
        name=$(ask "Название (подсказка)" "$cmd") || continue
        printf '%s|%s|%s\n' "$cmd" "$icon" "$name" >> "$DOCK_APPS"
        dock_apply; msg "Добавлено: $name";;
      "Удалить приложение")
        [ ${#labels[@]} -eq 0 ] && { err "Нечего удалять"; continue; }
        local sel; sel=$(pick "Что удалить?" "${labels[@]}") || continue
        local idx=-1 i
        for i in "${!labels[@]}"; do [ "${labels[$i]}" = "$sel" ] && { idx=$i; break; }; done
        [ "$idx" -lt 0 ] && continue
        local tmp="$DOCK_APPS.tmp"; : > "$tmp"
        local out_i=0
        while IFS= read -r line || [ -n "$line" ]; do
          if [[ -z "${line//[[:space:]]/}" || "$line" =~ ^[[:space:]]*# ]]; then
            echo "$line" >> "$tmp"; continue
          fi
          if [ "$out_i" -eq "$idx" ]; then
            out_i=$((out_i+1)); continue
          fi
          echo "$line" >> "$tmp"; out_i=$((out_i+1))
        done < "$DOCK_APPS"
        mv "$tmp" "$DOCK_APPS"
        dock_apply; msg "Удалено";;
      *)
        # tap on existing entry -> quick actions
        local sel="$c" idx=-1 i
        for i in "${!labels[@]}"; do [ "${labels[$i]}" = "$sel" ] && { idx=$i; break; }; done
        [ "$idx" -lt 0 ] && continue
        local act; act=$(pick "Действие: ${names[$idx]}" "Изменить" "Удалить" "Назад") || continue
        case "$act" in
          "Изменить")
            local cmd icon name
            cmd=$(ask "Команда" "${cmds[$idx]}") || continue
            icon=$(ask "Иконка" "${icons[$idx]}") || continue
            name=$(ask "Название" "${names[$idx]}") || continue
            local tmp="$DOCK_APPS.tmp"; : > "$tmp"; local out_i=0
            while IFS= read -r line || [ -n "$line" ]; do
              if [[ -z "${line//[[:space:]]/}" || "$line" =~ ^[[:space:]]*# ]]; then
                echo "$line" >> "$tmp"; continue
              fi
              if [ "$out_i" -eq "$idx" ]; then
                printf '%s|%s|%s\n' "$cmd" "$icon" "$name" >> "$tmp"
              else
                echo "$line" >> "$tmp"
              fi
              out_i=$((out_i+1))
            done < "$DOCK_APPS"
            mv "$tmp" "$DOCK_APPS"; dock_apply; msg "Изменено";;
          "Удалить")
            local tmp="$DOCK_APPS.tmp"; : > "$tmp"; local out_i=0
            while IFS= read -r line || [ -n "$line" ]; do
              if [[ -z "${line//[[:space:]]/}" || "$line" =~ ^[[:space:]]*# ]]; then
                echo "$line" >> "$tmp"; continue
              fi
              [ "$out_i" -eq "$idx" ] || echo "$line" >> "$tmp"
              out_i=$((out_i+1))
            done < "$DOCK_APPS"
            mv "$tmp" "$DOCK_APPS"; dock_apply; msg "Удалено";;
        esac
        ;;
    esac
  done
}

menu_dock() {
  while true; do
    load_env
    local run_state="остановлен"; dock_is_running && run_state="запущен"
    local en_state="выкл"; [ "${DOCK_ENABLED:-0}" = "1" ] && en_state="вкл"
    local task_state="выкл"; [ "${DOCK_SHOW_TASKBAR:-1}" = "1" ] && task_state="вкл"
    local ex_state="нет"; [ "${DOCK_EXCLUSIVE:-0}" = "1" ] && ex_state="да"
    local ah_state="закреплён"; [ "${DOCK_AUTOHIDE:-0}" = "1" ] && ah_state="ниже"
    local c; c=$(pick "Док (Waybar)  ·  $ah_state  ·  автозапуск: $en_state  ·  сейчас: $run_state" \
      "Показать/скрыть док сейчас" \
      "Автозапуск дока: вкл/выкл ($en_state)" \
      "Режим: закреплён / ниже ($ah_state)" \
      "Положение (${DOCK_POSITION:-bottom})" \
      "Размер иконок (${DOCK_ICON_SIZE:-26})" \
      "Высота/толщина дока (${DOCK_HEIGHT:-48})" \
      "Отступ от края (${DOCK_MARGIN:-8})" \
      "Скругление (${DOCK_RADIUS:-20})" \
      "Прозрачность фона (${DOCK_BG_OPACITY:-0.78})" \
      "Слой (${DOCK_LAYER:-top})" \
      "Показывать запущенные приложения: вкл/выкл ($task_state)" \
      "Резервировать место под док: вкл/выкл ($ex_state)" \
      "Закреплённые приложения…" \
      "Применить/перезапустить док" \
      "Перегенерировать конфиг дока" \
      "Редактировать dock.jsonc" "Редактировать dock.css" "Редактировать dock-apps.list" \
      "Назад") || return
    local v
    case "$c" in
      "Назад") return;;
      "Показать/скрыть док сейчас") dock_toggle_runtime; sleep 0.2;;
      "Автозапуск дока: вкл/выкл ("*")")
        if [ "${DOCK_ENABLED:-0}" = "1" ]; then
          set_env DOCK_ENABLED 0; msg "Автозапуск дока выключен"
        else
          set_env DOCK_ENABLED 1; msg "Автозапуск дока включён"
          dock_apply; [ -x "$SCR/dock" ] && "$SCR/dock" start >/dev/null 2>&1 || true
        fi;;
      "Режим: закреплён / ниже ("*")")
        v=$(pick "Режим дока" "Закреплён (всегда виден, с отступом)" "Ниже (у края экрана, всегда виден)") || continue
        case "$v" in
          "Ниже"*)
            set_env DOCK_AUTOHIDE 1
            msg "Док будет у самого края экрана (ниже)";;
          *)
            set_env DOCK_AUTOHIDE 0
            msg "Док закреплён (с отступом)";;
        esac
        dock_apply;;
      "Положение ("*")")
        v=$(pick "Положение дока" bottom top left right) || continue
        set_env DOCK_POSITION "$v"; dock_apply; msg "Положение: $v";;
      "Размер иконок ("*")")
        v=$(pick "Размер иконок, px" 18 20 22 24 26 28 32 36 40 48) || continue
        set_env DOCK_ICON_SIZE "$v"; dock_apply; msg "Размер иконок: $v";;
      "Высота/толщина дока ("*")")
        v=$(pick "Высота/толщина, px" 36 40 44 48 52 56 64 72) || continue
        set_env DOCK_HEIGHT "$v"; dock_apply; msg "Высота: $v";;
      "Отступ от края ("*")")
        if [ "${DOCK_AUTOHIDE:-0}" = "1" ]; then err "В режиме «ниже» отступ от края не используется"; continue; fi
        v=$(pick "Отступ, px" 0 4 6 8 10 12 16 20 24) || continue
        set_env DOCK_MARGIN "$v"; dock_apply; msg "Отступ: $v";;
      "Скругление ("*")")
        v=$(pick "Радиус, px" 0 8 12 16 20 24 28 32) || continue
        set_env DOCK_RADIUS "$v"; dock_apply; msg "Скругление: $v";;
      "Прозрачность фона ("*")")
        v=$(pick "Непрозрачность фона" 0.0 0.35 0.5 0.65 0.78 0.85 0.92 1.0) || continue
        set_env DOCK_BG_OPACITY "$v"; dock_apply; msg "Прозрачность: $v";;
      "Слой ("*")")
        v=$(pick "Слой" top overlay bottom) || continue
        set_env DOCK_LAYER "$v"; dock_apply; msg "Слой: $v";;
      "Показывать запущенные приложения: вкл/выкл ("*")")
        if [ "${DOCK_SHOW_TASKBAR:-1}" = "1" ]; then set_env DOCK_SHOW_TASKBAR 0; else set_env DOCK_SHOW_TASKBAR 1; fi
        dock_apply; msg "Обновлено";;
      "Резервировать место под док: вкл/выкл ("*")")
        if [ "${DOCK_EXCLUSIVE:-0}" = "1" ]; then set_env DOCK_EXCLUSIVE 0; else set_env DOCK_EXCLUSIVE 1; fi
        dock_apply; msg "Обновлено";;
      "Закреплённые приложения…") menu_dock_apps;;
      "Применить/перезапустить док")
        if [ -x "$SCR/dock" ]; then "$SCR/dock" restart >/dev/null 2>&1 || "$SCR/dock" start >/dev/null 2>&1 || true; msg "Док применён"; else err "Нет скрипта дока"; fi;;
      "Перегенерировать конфиг дока")
        if [ -x "$SCR/dock" ]; then "$SCR/dock" generate >/dev/null 2>&1 || true; msg "Конфиг дока сгенерирован"; else err "Нет скрипта дока"; fi;;
      "Редактировать dock.jsonc") ${EDITOR:-nano} "$DOCK_CFG"; dock_apply;;
      "Редактировать dock.css") ${EDITOR:-nano} "$DOCK_CSS"; dock_apply;;
      "Редактировать dock-apps.list") ${EDITOR:-nano} "$DOCK_APPS"; dock_apply;;
    esac
  done
}

menu_files() {
  local c; c=$(pick "Файлы конфигов" "config.conf" "settings.env" "autostart.sh" "launch" "power-menu" "dock (скрипт)" "dock-apps.list") || return
  case "$c" in
    "config.conf")  ${EDITOR:-nano} "$CONF"; reload;;
    "settings.env") ${EDITOR:-nano} "$ENVF";;
    "autostart.sh") ${EDITOR:-nano} "$SCR/autostart.sh";;
    "launch")       ${EDITOR:-nano} "$SCR/launch";;
    "power-menu")   ${EDITOR:-nano} "$SCR/power-menu";;
    "dock (скрипт)") ${EDITOR:-nano} "$SCR/dock";;
    "dock-apps.list") ${EDITOR:-nano} "$DOCK_APPS"; dock_apply;;
  esac
}

# ── CLI: mango-settings accent HEX (использует install.sh) ───────────────
if [ "$1" = accent ] && [[ "$2" =~ ^[0-9a-fA-F]{6}$ ]]; then
  apply_accent "$2"; exit 0
fi

command -v gum >/dev/null || { echo "Нужен gum:  sudo pacman -S gum"; read -r; exit 1; }

# ── Главное меню ─────────────────────────────────────────────────────────
while true; do
  load_env
  clear
  gum style --border rounded --border-foreground "#$ACCENT" --foreground "#$ACCENT" \
            --padding "0 3" --margin "1 2" --bold "MangoWC · Настройки"
  gum style --foreground "#7f849c" "  Super+S или Esc — закрыть"
  echo
  c=$(gum choose --height 18 --header "Что настроить?" \
      "Тема и цвет (Matugen/ручной)" "Окна" "Эффекты и анимации" "Панель Waybar" "Док" "Обои" "Терминал" \
      "Клавиатура" "Тачпад" "Поведение" "Тайлинг" "Приложения по умолчанию" \
      "Файлы конфигов" "Применить всё" "Выход") || exit 0

  case "$c" in
    "Тема и цвет (Matugen/ручной)") menu_theme;;
    "Окна")                     menu_windows;;
    "Эффекты и анимации")       menu_effects;;
    "Панель Waybar")            menu_bar;;
    "Док")                      menu_dock;;
    "Обои")                     menu_wallpaper;;
    "Терминал")                 menu_terminal;;
    "Клавиатура")               menu_keyboard;;
    "Тачпад")                   menu_touchpad;;
    "Поведение")                menu_behavior;;
    "Тайлинг")                  menu_tiling;;
    "Приложения по умолчанию")  menu_apps;;
    "Файлы конфигов")           menu_files;;
    "Применить всё")            reload; bar_reload; dock_apply; msg "Применено";;
    "Выход")                    exit 0;;
  esac
done
