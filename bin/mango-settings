    "Натуральная прокрутка")    toggle_conf trackpad_natural_scrolling "Натуральная прокрутка";;
  esac
}

menu_behavior() {
  local c v; c=$(pick "Поведение" "Фокус за мышью" "Курсор прыгает на окно" "Фокус на активированное окно" \
    "Прилипание плавающих окон" "Дистанция прилипания" "Скрывать курсор (сек)" "Размер курсора") || return
  case "$c" in
    "Фокус за мышью")                toggle_conf sloppy_focus "Фокус за мышью";;
    "Курсор прыгает на окно")        toggle_conf warp_cursor "Курсор прыгает на окно";;
    "Фокус на активированное окно")  toggle_conf focus_on_activate "Фокус на активированное окно";;
    "Прилипание плавающих окон")     toggle_conf enable_floating_snap "Прилипание";;
    "Дистанция прилипания")          set_pick snap_distance "px" 10 20 30 40 50 60;;
    "Скрывать курсор (сек)")         set_pick cursor_hide_timeout "сек (0 = никогда)" 0 2 3 4 5 8 10;;
    "Размер курсора")
      v=$(pick "px" 16 20 24 28 32 48) && {
        set_conf cursor_size "$v"; sed -i "s|^env=XCURSOR_SIZE,.*|env=XCURSOR_SIZE,$v|" "$CONF"; reload
        msg "Готово (полностью — после перезахода)"; };;
  esac
}

