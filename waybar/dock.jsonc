{
  "layer": "top",
  "position": "bottom",
  "exclusive": false,
  "passthrough": false,
  "gtk-layer-shell": true,
  "spacing": 6,
  "margin-top": 0,
  "margin-bottom": 8,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": [],
  "modules-center": [
    "custom/dock-app-0",
    "custom/dock-app-1",
    "custom/dock-app-2",
    "custom/dock-app-3",
    "custom/dock-sep",
    "wlr/taskbar"
  ],
  "modules-right": [],
  "height": 48,
  "custom/dock-app-0": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Терминал",
    "on-click": "~/.config/mango/scripts/launch terminal"
  },
  "custom/dock-app-1": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Файлы",
    "on-click": "~/.config/mango/scripts/launch files"
  },
  "custom/dock-app-2": {
    "format": "󰈹",
    "tooltip": true,
    "tooltip-format": "Браузер",
    "on-click": "~/.config/mango/scripts/launch browser"
  },
  "custom/dock-app-3": {
    "format": "󰒓",
    "tooltip": true,
    "tooltip-format": "Настройки",
    "on-click": "~/.config/mango/scripts/launch settings"
  },
  "custom/dock-sep": {
    "format": "│",
    "tooltip": false
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 26,
    "icon-theme": "hicolor",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "on-click-right": "minimize",
    "all-outputs": false,
    "ignore-list": [
      "mango-settings",
      "mango-nmtui"
    ]
  }
}
